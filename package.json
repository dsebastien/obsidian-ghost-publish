{
    "name": "obsidian-ghost-publish",
    "version": "1.0.0",
    "description": "Publish your vault notes to a Ghost blog with configurable presets for tags, newsletters, and frontmatter conventions.",
    "author": {
        "name": "Sébastien Dubois",
        "email": "developassion.sprl@gmail.com",
        "url": "https://dsebastien.net"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "ghost",
        "ghost-blog",
        "publishing"
    ],
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dsebastien/obsidian-ghost-publish.git"
    },
    "bugs": {
        "url": "https://github.com/dsebastien/obsidian-ghost-publish/issues"
    },
    "homepage": "https://github.com/dsebastien/obsidian-ghost-publish",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.1.0"
    },
    "main": "main.js",
    "packageManager": "bun@1.4.0",
    "config": {
        "commitizen": {
            "path": "node_modules/cz-customizable"
        },
        "cz-customizable": {
            "config": ".cz-config.cjs"
        }
    },
    "scripts": {
        "dev": "bun scripts/build.ts",
        "build": "bun run tsc && bun scripts/build.ts --prod",
        "setup": "git config --local --replace-all include.path ../.gitconfig",
        "tsc": "tsc --noEmit",
        "tsc:watch": "tsc --noEmit --watch --preserveWatchOutput",
        "tscw": "bun run tsc:watch",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "bun test --isolate",
        "test:watch": "bun test --isolate --watch",
        "commit": "cz",
        "cm": "cz",
        "commit:lint": "commitlint --edit",
        "release:update-version": "bun scripts/update-version.ts",
        "release:version-bump": "bun scripts/version-bump.ts",
        "release:changelog": "bun scripts/generate-changelog.ts",
        "release": "./scripts/release.sh",
        "validate": "bun run --parallel tsc test lint rules:check",
        "rules:check": "bun scripts/rules-baseline.ts",
        "rules:baseline": "bun scripts/rules-baseline.ts --write"
    },
    "devDependencies": {
        "@commitlint/cli": "20.5.3",
        "@commitlint/config-conventional": "20.5.3",
        "@eslint/js": "9.39.4",
        "@tailwindcss/cli": "4.1.17",
        "@types/bun": "1.4.0",
        "@types/node": "24.10.1",
        "commitizen": "4.3.2",
        "conventional-changelog-cli": "5.0.0",
        "conventional-changelog-conventionalcommits": "9.1.0",
        "cz-customizable": "7.5.4",
        "eslint": "9.39.4",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-obsidianmd": "0.1.9",
        "globals": "17.0.0",
        "obsidian": "1.13.1",
        "prettier": "3.8.4",
        "tailwindcss": "4.1.17",
        "typescript": "5.9.3",
        "typescript-eslint": "8.48.1"
    },
    "dependencies": {
        "@leeoniya/ufuzzy": "1.0.19",
        "immer": "11.0.1",
        "marked": "18.0.3"
    },
    "overrides": {
        "@conventional-changelog/git-client": "2.7.0",
        "handlebars": "4.7.9",
        "lodash": "4.18.1",
        "fast-uri": "3.1.5",
        "flatted": "3.4.2",
        "yaml": "2.9.0",
        "js-yaml": "4.3.1",
        "tmp": "0.2.7",
        "brace-expansion": "2.1.4",
        "minimatch": "3.1.5",
        "picomatch": "2.3.2"
    }
}
